{
  "camera": {
    "index": 0,
    "width": 1280,
    "height": 720,
    "fps": 30,
    "buffer_size": 1,
    "backend": "dshow"
  },
  "aruco": {
    "dictionary": "DICT_4X4_50",
    "marker_ids": {
      "top_left": 0,
      "top_right": 1,
      "bottom_left": 2,
      "bottom_right": 3
    }
  },
  "pad": {
    "dot_width": 60,
    "dot_height": 40,
    "canonical_width": 600,
    "canonical_height": 400
  },
  "calibration": {
    "require_no_hand_for_update": true,
    "good_timeout_sec": 1.0,
    "lost_timeout_sec": 3.0
  },
  "hand": {
    "max_num_hands": 2,
    "min_detection_confidence": 0.5,
    "min_tracking_confidence": 0.5,
    "model_complexity": 1,
    "preferred_hand": "any"
  },
  "gesture": {
    "press_ratio": 0.35,
    "release_ratio": 0.55,
    "stable_frames": 3
  },
  "smoothing": {
    "alpha": 0.35
  },
  "websocket": {
    "host": "127.0.0.1",
    "port": 8765
  },
  "debug": {
    "draw_camera": true,
    "send_camera_image": false,
    "jpeg_quality": 75
  }
}
